{
  "name": "pbcplus",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.2",
  "publisher": "hcl1981",
  "author": "Jan Schulz",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://github.com/hcl1981/pbc-vscode",
  "repository": {
    "type": "git",
    "url": "https://github.com/hcl1981/pbc-vscode"
  },
  "bugs": {
    "url": "https://github.com/hcl1981/pbc-vscode/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Snippets",
    "Education"
  ],
  "keywords": [
    "PicoBoy",
    "PBC+",
    "RP2350",
    "Pico SDK",
    "Raspberry Pi Pico"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:pbc/pbc.h",
    "workspaceContains:CMakeLists.txt",
    "onLanguage:c"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pbcplus.newProject",
        "title": "%command.newProject%",
        "category": "PBC+"
      },
      {
        "command": "pbcplus.run",
        "title": "%command.run%",
        "category": "PBC+",
        "icon": "$(play)"
      },
      {
        "command": "pbcplus.debug",
        "title": "%command.debug%",
        "category": "PBC+",
        "icon": "$(debug-alt)"
      },
      {
        "command": "pbcplus.profile",
        "title": "%command.profile%",
        "category": "PBC+"
      },
      {
        "command": "pbcplus.stop",
        "title": "%command.stop%",
        "category": "PBC+"
      },
      {
        "command": "pbcplus.choosePbconpc",
        "title": "%command.choosePbconpc%",
        "category": "PBC+"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pbcplus.run",
          "when": "pbcplus.project"
        },
        {
          "command": "pbcplus.debug",
          "when": "pbcplus.project"
        },
        {
          "command": "pbcplus.profile",
          "when": "pbcplus.project"
        }
      ],
      "editor/title/run": [
        {
          "command": "pbcplus.run",
          "when": "pbcplus.project && resourceLangId == c",
          "group": "navigation@1"
        },
        {
          "command": "pbcplus.debug",
          "when": "pbcplus.project && resourceLangId == c",
          "group": "navigation@2"
        }
      ]
    },
    "snippets": [
      {
        "language": "c",
        "path": "./snippets/c.json"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "pbcplus.pbconpcPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.pbconpcPath%"
        },
        "pbcplus.gdbPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.gdbPath%"
        },
        "pbcplus.usbTerminal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.usbTerminal%"
        },
        "pbcplus.exactTiming": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.exactTiming%"
        },
        "pbcplus.hideDebugBuildHint": {
          "type": "boolean",
          "default": false,
          "description": "%config.hideDebugBuildHint%"
        },
        "pbcplus.templateUrl": {
          "type": "string",
          "default": "https://pbcplus.de/downloads/pbc-vorlage.zip",
          "description": "%config.templateUrl%"
        }
      }
    }
  },
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrusted%",
      "restrictedConfigurations": [
        "pbcplus.pbconpcPath",
        "pbcplus.gdbPath",
        "pbcplus.templateUrl"
      ]
    },
    "virtualWorkspaces": false
  },
  "extensionPack": [
    "raspberry-pi.raspberry-pi-pico"
  ]
}
